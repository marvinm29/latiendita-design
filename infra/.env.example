# LaTiendita — 5 variables de entorno (T-08 / D7). Nunca commitees .env real.
# Copia este archivo a infra/.env y edítalo:

# Dominio público de la tienda (Caddy/Let's Encrypt). En dev local: localhost
DOMAIN=localhost

# Contraseña del usuario de Postgres (genera una fuerte: `openssl rand -hex 24`)
POSTGRES_PASSWORD=cambiar-esta-clave

# Secreto para firmar/rotar sesiones (token opaco de la API)
SESSION_SECRET=cambiar-este-secreto

# true = siembra la tienda de demostración en el primer arranque; false en producción
DEMO_SEED=false

# Expresión cron del respaldo pg_dump (minuto hora día mes día_semana), ej. 0 3 * * *
BACKUP_CRON=0 3 * * *
